digraph ERD {
  graph [rankdir=LR, nodesep=0.8, ranksep=1.3, pad=0.4, bgcolor="white", splines=true];
  node  [shape=plaintext, fontname="Helvetica", fontsize=12];
  edge  [color="#4b2a6b", fontname="Helvetica", fontsize=11, dir=both, arrowtail=tee, arrowhead=crow, fontcolor="#333333"];

  user [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6f4297">
   <TR><TD COLSPAN="2" BGCOLOR="#6f4297"><FONT COLOR="white"><B>accounts_user</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">username (unique)</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">password (haché)</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">first_name, last_name</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">email, telephone</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">role (patient/medecin/admin)</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">is_superuser, date_joined…</TD></TR></TABLE>>];
  spec [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6f4297">
   <TR><TD COLSPAN="2" BGCOLOR="#6f4297"><FONT COLOR="white"><B>rdv_specialite</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">nom (unique)</TD></TR></TABLE>>];
  med [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6f4297">
   <TR><TD COLSPAN="2" BGCOLOR="#6f4297"><FONT COLOR="white"><B>rdv_medecin</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">user_id (unique) → accounts_user</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">specialite_id → rdv_specialite</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">bio, tarif</TD></TR></TABLE>>];
  rdv [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2f9e6f">
   <TR><TD COLSPAN="2" BGCOLOR="#2f9e6f"><FONT COLOR="white"><B>rdv_rendezvous</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">patient_id → accounts_user</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">medecin_id → rdv_medecin</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">date, heure, motif, notes</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">statut (attente/confirme/annule/termine)</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">cree_le</TD></TR></TABLE>>];
  dispo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6f4297">
   <TR><TD COLSPAN="2" BGCOLOR="#6f4297"><FONT COLOR="white"><B>rdv_disponibilite</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">medecin_id → rdv_medecin</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">jour (0-6), debut, fin</TD></TR></TABLE>>];
  conge [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6f4297">
   <TR><TD COLSPAN="2" BGCOLOR="#6f4297"><FONT COLOR="white"><B>rdv_indisponibilite</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">medecin_id → rdv_medecin</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">debut, fin, motif</TD></TR></TABLE>>];
  avis [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#e0a800">
   <TR><TD COLSPAN="2" BGCOLOR="#e0a800"><FONT COLOR="white"><B>rdv_avis</B></FONT></TD></TR>
   <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
   <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">rdv_id (unique) → rdv_rendezvous</TD></TR>
   <TR><TD></TD><TD ALIGN="LEFT">note (1-5), commentaire, cree_le</TD></TR></TABLE>>];

  spec -> med  [taillabel="1", headlabel="N", arrowtail=tee, arrowhead=crow, labeldistance=2];
  user -> med  [taillabel="1", headlabel="0..1", arrowhead=tee, labeldistance=2.2, label="  est"];
  user -> rdv  [taillabel="1", headlabel="N", labeldistance=2, label="  patient"];
  med  -> rdv  [taillabel="1", headlabel="N", labeldistance=2];
  med  -> dispo [taillabel="1", headlabel="N", labeldistance=2];
  med  -> conge [taillabel="1", headlabel="N", labeldistance=2];
  rdv  -> avis [taillabel="1", headlabel="0..1", arrowhead=tee, labeldistance=2.2];
}
